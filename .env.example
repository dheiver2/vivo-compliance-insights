# Análise de ligações por IA (rota /analyze).
# Copie para .env e preencha com seu token da HuggingFace (https://huggingface.co/settings/tokens).
# Sem token, a rota /analyze usa um fallback heurístico local.
HF_TOKEN=

# Opcional: modelo servido via HuggingFace Inference Providers.
# Padrão: meta-llama/Llama-3.1-8B-Instruct
HF_MODEL=
