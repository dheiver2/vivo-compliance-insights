# Análise de ligações por IA (rota /analyze).
#
# Provedor PRINCIPAL: Mangaba Gateway (self-hosted, exposto via ngrok). Não
# exige token — é sempre tentado primeiro. Opcional: sobrescreve a URL padrão
# (https://mangaba.ngrok.app).
MANGABA_GATEWAY_URL=

# Provedor FALLBACK: HuggingFace Inference Providers, usado só se o Mangaba
# Gateway falhar/estiver indisponível. Copie para .env e preencha com seu
# token (https://huggingface.co/settings/tokens). Sem token E sem gateway
# disponível, a rota /analyze usa um fallback heurístico local.
HF_TOKEN=

# Opcional: modelo servido via HuggingFace Inference Providers (fallback).
# Padrão: meta-llama/Llama-3.1-8B-Instruct
HF_MODEL=
